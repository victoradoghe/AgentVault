{
  "name": "amc-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (stdio) server for AgentVault. Gives coding agents persistent, project-scoped memory by wrapping the AgentVault REST API.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-memory-cloud",
    "amc",
    "memory",
    "ai-agents"
  ],
  "homepage": "https://github.com/victoradoghe/AgentVault/tree/master/packages/amc-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victoradoghe/AgentVault.git",
    "directory": "packages/amc-mcp"
  },
  "bugs": {
    "url": "https://github.com/victoradoghe/AgentVault/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "amc-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.5.0"
  }
}
