# AgentVault — environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# ---- Database (Postgres / Supabase) ----
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/amc?schema=public"
# Direct (non-pooled) connection string used for migrations.
DIRECT_URL="postgresql://user:password@localhost:5432/amc?schema=public"

# ---- Supabase (required in production) ----
# LEAVE THESE BLANK for local development: you "log in" with any email and no
# password, and the session is a signed cookie + localStorage. Fill them in to
# switch the whole app to real Supabase Auth — no code change required.
#
# In a PRODUCTION build these are effectively required. The passwordless local
# mode is refused there (it would let any visitor sign in as any user), so
# without them nobody can sign in at all. See src/lib/auth-mode.ts.
#
# Public project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=""
# Public anon/publishable key (safe to expose to the browser). Either name works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key — SERVER ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Local dev auth (optional) ----
# Secret used to sign local-mode session cookies. A committed dev fallback is
# used if unset — which is fine on a laptop and unsafe anywhere else, so in
# production the fallback is refused and this must be set. Ignored once Supabase
# is configured.
AMC_LOCAL_AUTH_SECRET=""

# Opt in to passwordless local auth in a PRODUCTION build. Off by default, and
# should stay off unless the deployment is genuinely private: with it on, anyone
# who can reach the app can sign in as anyone. Requires AMC_LOCAL_AUTH_SECRET.
NEXT_PUBLIC_AMC_ALLOW_LOCAL_AUTH=""

# ---- Database timeouts (optional) ----
# Interactive-transaction budgets in milliseconds. The defaults are generous so
# a distant/pooled database causes slowness rather than failure; tighten them
# when Postgres is local. See src/lib/prisma.ts.
AMC_DB_TRANSACTION_MAX_WAIT_MS=""
AMC_DB_TRANSACTION_TIMEOUT_MS=""

# ---- Embeddings (optional) ----
# The embedding model (~90 MB) is downloaded from huggingface.co on first use. On a
# network that can't reach it, point this at a mirror (e.g. https://hf-mirror.com).
HF_ENDPOINT=""

# Where that model is cached. Defaults to .model-cache/ in the repo root, which is
# deliberately OUTSIDE node_modules so `pnpm install` cannot delete it and break
# embedding on a machine with no connection. Point several checkouts at one shared
# directory to download it only once. Prime it with `pnpm model:fetch`.
AMC_MODEL_CACHE_DIR=""
