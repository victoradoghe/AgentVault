# AgentVault — environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# ---- Database (Postgres / Supabase) ----
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/amc?schema=public"
# Direct (non-pooled) connection string used for migrations.
DIRECT_URL="postgresql://user:password@localhost:5432/amc?schema=public"

# ---- Supabase (optional) ----
# LEAVE THESE BLANK to run on the local dev auth stopgap: "log in" with any
# email (no password), session kept in a signed cookie + localStorage. Fill them
# in to switch the whole app to real Supabase Auth — no code change required.
#
# Public project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=""
# Public anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key — SERVER ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Local dev auth (optional) ----
# Secret used to sign local-mode session cookies. Optional; a dev fallback is
# used if unset. Ignored once Supabase is configured.
AMC_LOCAL_AUTH_SECRET=""

# ---- Embeddings (optional) ----
# The embedding model is downloaded from huggingface.co on first use. On a
# network that can't reach it, point this at a mirror (e.g. https://hf-mirror.com).
HF_ENDPOINT=""
